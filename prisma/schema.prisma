generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  password      String
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  careerReviews CareerReview[]
  logs          Log[]
  profile       StudentProfile?
}

model StudentProfile {
  id                  Int               @id @default(autoincrement())
  studentCode         String            @unique
  firstNameTh         String
  lastNameTh          String
  phoneNumber         String?
  department          String            @default("การจัดการเทคโนโลยีสารการผลิตและสารสนเทศ")
  entryYear           Int
  gradYear            Int?
  jobField            String?
  userId              Int               @unique
  updatedAt           DateTime          @updatedAt
  continued_from_coop Boolean           @default(false)
  employment_sector   EmploymentSector?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Log {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  userId    Int?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model JwtBlacklist {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
}

model CareerReview {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  jobField    String?
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("pending")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
  OWNER
}

enum EmploymentSector {
  PRIVATE
  GOVERNMENT
  STATE_ENTERPRISE
  SELF_EMPLOYED
}
